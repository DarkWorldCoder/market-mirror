            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "url": "https://...",
                "ads_summary": {},
                "refresh": false,
                "name": "Brand"
              }
            }
          }
        }
      },
      "get": {
        "summary": "The project's product profile",
        "tags": [
          "Product understanding"
