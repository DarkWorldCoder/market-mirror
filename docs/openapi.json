    "/api/simulation/website-test": {
      "post": {
        "summary": "Real-browser journeys by synthetic visitors with screenshots and supplied DOM outcome checks; background task",
        "tags": [
          "Tests on simulated people"
        ],
        "responses": {
          "200": {
            "description": "{task_id, simulation_id, run_id}",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "bad request"
          },
          "404": {
            "description": "not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "simulation_id": "sim_x",
                "spec": {
                  "url": "https://your-product.example",
                  "goal": "add_to_cart",
                  "max_personas": 3,
                  "checks": [
                    {
                      "name": "cart_added",
                      "selector": "[data-testid=cart-count]",
                      "text": "1"
                    }
                  ],
                  "goal_check": "cart_added",
                  "observation_mode": "compact",
                  "max_model_calls": 12,
                  "max_input_tokens": 100000,
                  "max_elapsed_s": 180
                }
              }
            }
          }
        }
      }
    },
    "/api/simulation/{simulation_id}/website-test": {
      "get": {
        "summary": "Browser journey evidence; optional ?run_id=website_x selects the exact run",
