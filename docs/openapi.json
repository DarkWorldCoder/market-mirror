{
  "openapi": "3.0.3",
  "info": {
    "title": "MarketMirror API",
    "version": "0.3.0",
    "description": "Marketing and sales simulation on simulated buyers. Long jobs return task ids."
  },
  "servers": [
    {
      "url": "http://localhost:5001"
    }
  ],
  "tags": [
    {
      "name": "Product understanding"
    },
    {
      "name": "Real voices"
    },
    {
      "name": "Campaign planning"
    },
    {
      "name": "Tests on simulated people"
    },
    {
      "name": "Inside the rounds"
    },
    {
      "name": "Analysis and reports"
    },
    {
      "name": "Reliability and prediction"
    },
    {
      "name": "Background tasks"
    }
  ],
  "paths": {
    "/api/graph/profile": {
      "post": {
        "summary": "Product profile from text/url/ads (no project)",
        "tags": [
          "Product understanding"
        ],
        "responses": {
          "200": {
            "description": "product profile + quickstart_answers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "bad request"
          },
          "404": {
            "description": "not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "text": "...",
                "url": "https://...",
                "ads_summary": {},
                "name": "Brand"
              }
            }
          }
        }
      }
    },
