# ===== LLM configuration =====
# LLM_PROVIDER=claude (default) uses Anthropic's OpenAI-compatible endpoint.
# LLM_API_KEY falls back to ANTHROPIC_API_KEY when LLM_PROVIDER=claude.
# Set LLM_PROVIDER=openai to use any other OpenAI-format API (OpenAI, Qwen/DashScope, ...).
# Simulations make many LLM calls; try a run with fewer than 40 rounds first.
LLM_PROVIDER=claude
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL_NAME=claude-haiku-4-5

# ===== No API key: gateway over your Claude Code / ChatGPT login (personal use) =====
# Start it with: python backend/gateway/local_gateway.py --backend claude   (or codex)
# then use these instead of the three LLM_* lines above:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:5055/v1
# LLM_API_KEY=gateway
# LLM_GATEWAY=claude
# LLM_MODEL_NAME=claude

# ===== Memory / knowledge-graph backend =====
# local (default): free, self-contained SQLite graph. Entities and relationships
#                  are extracted from your documents with the LLM configured above;
#                  search is hybrid BM25 + local embeddings (no API key needed).
# cognee:          optional Cognee (open source) extraction + search. Cognee runs as a
#                  sidecar in its own venv because it conflicts with camel-ai's pins:
#                  backend/memory_sidecar/cognee_sidecar.sh setup && ... start
# zep:             legacy hosted Zep Cloud (https://app.getzep.com/), requires ZEP_API_KEY.
MEMORY_BACKEND=local

# SQLite file for the local backend (default: backend/uploads/local_graph.db).
# LOCAL_GRAPH_DB=/absolute/path/to/local_graph.db

# Local embeddings (fastembed, ONNX on CPU, downloaded once, ~220 MB). If fastembed or
# the model is unavailable the backend silently falls back to BM25 keyword search.
MEMORY_EMBEDDINGS=true
# Multilingual default (English/Chinese/Indonesian/Malay/Hindi/... ~50 languages).
# English-only and smaller/faster: BAAI/bge-small-en-v1.5
# MEMORY_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Model cache (default: backend/uploads/models; FASTEMBED_CACHE_PATH is honoured too).
# MEMORY_EMBED_CACHE_DIR=/absolute/path/to/models
# Merge same-type entities whose names embed at least this similar (0-1).
# MEMORY_ENTITY_SIMILARITY=0.9
# Minimum cosine similarity for a semantic search hit.
# MEMORY_MIN_SIMILARITY=0.3

# Also run LLM entity extraction on simulation activity episodes (local/cognee only).
# Off by default because it costs one LLM call per activity batch; when off, activity
# is still stored and searchable.
MEMORY_EXTRACT_ACTIVITY=false

# Number of parallel LLM extraction workers for the local backend.
# LOCAL_GRAPH_EXTRACT_WORKERS=4
# Characters of one chunk/episode sent to the extraction LLM (longer text is truncated).
# LOCAL_GRAPH_MAX_EPISODE_CHARS=6000

# ===== Cognee sidecar (optional, only used when MEMORY_BACKEND=cognee) =====
# The sidecar reuses LLM_PROVIDER/LLM_API_KEY/LLM_MODEL_NAME (claude -> Cognee's anthropic
# provider) and MEMORY_EMBED_MODEL (fastembed). Data lives in backend/uploads/cognee.
# COGNEE_SIDECAR_URL=http://127.0.0.1:8765
# COGNEE_SIDECAR_PORT=8765
# COGNEE_INGEST_BATCH=20
# COGNEE_DATA_DIR=/absolute/path/to/cognee-data

# ===== Zep Cloud (legacy, only used when MEMORY_BACKEND=zep) =====
# ZEP_API_KEY=your_zep_api_key_here

# ===== Boost LLM configuration (optional) =====
# Leave these out of your .env entirely if you do not use a boost model.
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
