# ===== LLM configuration =====
# LLM_PROVIDER=claude (default) uses Anthropic's OpenAI-compatible endpoint.
# LLM_API_KEY falls back to ANTHROPIC_API_KEY when LLM_PROVIDER=claude.
# Set LLM_PROVIDER=openai to use any other OpenAI-format API (OpenAI, Qwen/DashScope, ...).
# Simulations make many LLM calls; try a run with fewer than 40 rounds first.
LLM_PROVIDER=claude
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL_NAME=claude-haiku-4-5

# ===== Memory / knowledge-graph backend =====
# local (default): free, self-contained SQLite graph. Entities and relationships
#                  are extracted from your documents with the LLM configured above.
# zep:             hosted Zep Cloud (https://app.getzep.com/), requires ZEP_API_KEY.
MEMORY_BACKEND=local

# SQLite file for the local backend (default: backend/uploads/local_graph.db).
# LOCAL_GRAPH_DB=/absolute/path/to/local_graph.db

# Also run LLM entity extraction on simulation activity episodes (local backend only).
# Off by default because it costs one LLM call per activity batch; when off, activity
# is still stored and keyword-searchable.
MEMORY_EXTRACT_ACTIVITY=false

# Number of parallel LLM extraction workers for the local backend.
# LOCAL_GRAPH_EXTRACT_WORKERS=4

# ===== Zep Cloud (optional, only used when MEMORY_BACKEND=zep) =====
# ZEP_API_KEY=your_zep_api_key_here

# ===== Boost LLM configuration (optional) =====
# Leave these out of your .env entirely if you do not use a boost model.
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
