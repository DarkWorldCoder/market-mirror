# MarketMirror Production Environment Template (.env.production.example)
# Copy to .env in production and set strong secrets.

# --- Runtime & Production Security ---
MM_ENV=production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
SECRET_KEY=replace-with-a-strong-random-64-char-secret
MM_API_AUTH_TOKEN=replace-with-production-bearer-api-token
MM_RATE_LIMIT_RPM=120
TRUST_PROXY_HEADERS=1
CORS_ORIGINS=https://your-domain.example.com

# --- Multi-Provider AI Pool (Claude + ChatGPT + Codex + Gemini + Ollama) ---
# Pool-aware stages (feed test, survey, panel, personas) spread calls over LLM_POOL. Every other stage (ontology,
# graph build, OASIS rounds, reports) uses the single provider below, so it must be a real provider: here the
# pool's first entry (its key comes from ANTHROPIC_API_KEY).
LLM_PROVIDER=claude
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL_NAME=claude-sonnet-4-5
LLM_POOL=claude:claude-sonnet-4-5,openai:gpt-5.4,gemini:gemini-2.5-flash
MARKET_MIRROR_PROVIDER=multi
# Login gateways in the pool (codex, antigravity) need their own URL and token, never OPENAI_API_KEY:
# CODEX_GATEWAY_URL=http://127.0.0.1:5092/v1
# CODEX_GATEWAY_KEY=<contents of backend/logs/gateway-5092.token>
# ANTIGRAVITY_GATEWAY_URL=http://127.0.0.1:5093/v1
# ANTIGRAVITY_GATEWAY_KEY=<contents of backend/logs/gateway-5093.token>

# Provider API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Storage & Task Persistence ---
MEMORY_BACKEND=local
# Optional custom path for persistent SQLite task state across workers:
# MM_TASK_DB_PATH=/app/backend/uploads/tasks.sqlite
