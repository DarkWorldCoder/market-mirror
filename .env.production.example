# MarketMirror Production Environment Template (.env.production.example)
# Copy to .env in production and set strong secrets.
# With MM_ENV=production the backend REFUSES TO START while any value below is still a
# placeholder, and on a non-loopback FLASK_HOST (0.0.0.0, as in Docker) it also requires
# MM_API_AUTH_TOKEN and an explicit CORS_ORIGINS. Generate secrets with: openssl rand -hex 32

# --- Runtime & Production Security ---
MM_ENV=production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
# Required, >= 32 random characters (never the old default "mirofish-secret-key").
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
# Required on a non-loopback host, >= 32 random characters. Clients send it as
# "Authorization: Bearer <token>" (or X-API-Key). The CLI, live view, MCP server and SDK
# read MM_API_AUTH_TOKEN from the environment or from this .env file.
MM_API_AUTH_TOKEN=replace-with-output-of-openssl-rand-hex-32
# Failed-auth attempts allowed per client per minute before a 429 lockout (0 disables).
MM_AUTH_FAIL_LIMIT=10
MM_RATE_LIMIT_RPM=120
# 1 ONLY behind a reverse proxy that sets X-Forwarded-For (nginx, Caddy, a load balancer);
# otherwise clients could spoof their address. TRUST_PROXY_HOPS = number of proxies in front.
TRUST_PROXY_HEADERS=0
TRUST_PROXY_HOPS=1
# Required on a non-loopback host: comma-separated browser origins allowed to call /api
# (scheme://host[:port], no path), or "none" when only the CLI/SDK call the API. "*" is refused.
CORS_ORIGINS=none
# Request threads of the single server process, and seconds in-flight requests get on SIGTERM.
MM_THREADS=32
MM_SHUTDOWN_GRACE=10

# --- Multi-Provider AI Pool (Claude + ChatGPT + Codex + Gemini + Ollama) ---
# Pool-aware stages (feed test, survey, panel, personas) spread calls over LLM_POOL. Every other stage (ontology,
# graph build, OASIS rounds, reports) uses the single provider below, so it must be a real provider: here the
# pool's first entry (its key comes from ANTHROPIC_API_KEY).
LLM_PROVIDER=claude
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL_NAME=claude-sonnet-4-5
LLM_POOL=claude:claude-sonnet-4-5,openai:gpt-5.4,gemini:gemini-2.5-flash
MARKET_MIRROR_PROVIDER=multi
# Login gateways in the pool (codex, antigravity) need their own URL and token, never OPENAI_API_KEY:
# CODEX_GATEWAY_URL=http://127.0.0.1:5092/v1
# CODEX_GATEWAY_KEY=<contents of backend/logs/gateway-5092.token>
# ANTIGRAVITY_GATEWAY_URL=http://127.0.0.1:5093/v1
# ANTIGRAVITY_GATEWAY_KEY=<contents of backend/logs/gateway-5093.token>

# Provider API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Storage & Task Persistence ---
MEMORY_BACKEND=local
# Optional custom path for persistent SQLite task state across workers:
# MM_TASK_DB_PATH=/app/backend/uploads/tasks.sqlite
